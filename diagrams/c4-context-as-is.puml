@startuml c4-context-as-is
!include <C4/C4_Context>

title Диаграмма контекста: Умный дом (As-Is, монолит)

Person(client, "Клиент API", "Любой клиент (веб-клиент, Postman): аутентификации и ролей нет")

System(monolith, "Умный дом (монолит)", "Приложение на Go с БД PostgreSQL: регистрация датчиков температуры, хранение последних значений, чтение температуры")

System_Ext(tempApi, "temperature-api", "Внешний сервис-источник температуры по датчику или локации")

Rel(client, monolith, "Регистрирует датчики, читает показания, вручную обновляет значения", "HTTP/REST")
Rel(monolith, tempApi, "Синхронно запрашивает текущую температуру", "HTTP/REST")

SHOW_LEGEND()
@enduml
