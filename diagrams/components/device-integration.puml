@startuml device-integration
!include <C4/C4_Component>

title Диаграмма компонентов: Модуль интеграции приборов

Container(Gateway, "API Gateway", ".NET (YARP)", "Единая точка входа: маршрутизация запросов к сервисам, проверка токена")
Container(Telematics, "Модуль телематики", ".NET", "Микросервис: управление приборами и телеметрия")
Container(Automation, "Модуль автоматизации", ".NET", "Микросервис: конструктор и выполнение сценариев")
System_Ext(devices, "Приборы партнёров", "Датчики и исполнительные устройства: отопление, свет, ворота и др.")
ContainerQueue(Broker, "Брокер сообщений", "RabbitMQ", "Доставка событий подписчикам: очередь на каждого подписчика, повторные попытки, очередь недоставленных")
ContainerDb(dbDIS, "БД модуля интеграции приборов", "PostgreSQL", "Адаптеры, категории и модели приборов")

Container_Boundary(DeviceIntegration, "Модуль интеграции приборов") {
    Component(api, "API-контроллер", ".NET", "Принимает запросы: каталог моделей приборов, возможности приборов, команды и опрос")
    Component(catalog, "Сервис каталога моделей приборов", ".NET", "Описание модели как данных: категория (свет, отопление, ворота, камеры и др.) и вид (датчик, исполнительное устройство, модуль управления), что измеряет, в каких единицах, какие команды принимает; единая модель команд категории и соответствие ей команд модели; новая модель добавляется записью без изменения кода; универсальная модель для неизвестных приборов (значение и единица измерения)")
    Component(adapters, "Адаптеры протоколов", ".NET", "Anti-corruption layer: выбирает адаптер по модели прибора, переводит команды единой модели категории в команды модели и протокол партнёра, показания — в единую внутреннюю модель")
    Component(publisher, "Публикатор результатов команд", ".NET", "Публикует в брокер результат команды от адаптера (с идентификатором команды)")
    Component(repo, "Репозиторий", ".NET", "Читает и пишет модели приборов и настройки адаптеров")
}

Rel(Gateway, api, "Каталог моделей приборов", "HTTPS")
Rel(Telematics, api, "Команды и опрос через адаптеры", "HTTPS")
Rel(Automation, api, "Возможности приборов из каталога", "HTTPS")

Rel(api, catalog, "Каталог моделей, возможности приборов")
Rel(api, adapters, "Команда или опрос прибора")
Rel(adapters, catalog, "Запрашивает модель прибора: протокол, команды, единицы")
Rel(adapters, devices, "Команды, показания", "Протоколы партнёров")
Rel(adapters, publisher, "Ответ прибора на команду")
Rel(publisher, Broker, "Публикует: результат команды от адаптера", "AMQP")

Rel(catalog, repo, "Читает и пишет модели приборов")
Rel(adapters, repo, "Читает настройки адаптеров")
Rel(repo, dbDIS, "Читает и пишет", "SQL")

SHOW_LEGEND()
@enduml
