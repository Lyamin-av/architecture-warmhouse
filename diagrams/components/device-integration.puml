@startuml device-integration
!include <C4/C4_Component>

title Диаграмма компонентов: Модуль интеграции приборов

Container(Gateway, "API Gateway", ".NET (YARP)", "Единая точка входа: маршрутизация запросов к сервисам, проверка токена")
Container(Telematics, "Модуль телематики", ".NET", "Микросервис: управление приборами и телеметрия")
Container(Automation, "Модуль автоматизации", ".NET", "Микросервис: конструктор и выполнение сценариев")
System_Ext(devices, "Приборы партнёров", "Датчики и исполнительные устройства: отопление, свет, ворота и др.")
ContainerDb(dbDIS, "БД модуля интеграции приборов", "PostgreSQL", "Адаптеры, типы приборов")

Container_Boundary(DeviceIntegration, "Модуль интеграции приборов") {
    Component(api, "API-контроллер", ".NET", "Принимает запросы: каталог типов приборов, возможности приборов, команды и опрос")
    Component(catalog, "Сервис каталога типов приборов", ".NET", "Описание типа как данных: что измеряет, в каких единицах, какие команды принимает; новый тип добавляется записью без изменения кода; универсальный тип для неизвестных приборов (значение и единица измерения)")
    Component(adapters, "Адаптеры протоколов", ".NET", "Anti-corruption layer: выбирает адаптер по типу прибора, переводит команды и показания между протоколом партнёра и единой внутренней моделью")
    Component(repo, "Репозиторий", ".NET", "Читает и пишет типы приборов и настройки адаптеров")
}

Rel(Gateway, api, "Каталог типов приборов", "HTTPS")
Rel(Telematics, api, "Команды и опрос через адаптеры", "HTTPS")
Rel(Automation, api, "Возможности приборов из каталога", "HTTPS")

Rel(api, catalog, "Каталог типов, возможности приборов")
Rel(api, adapters, "Команда или опрос прибора")
Rel(adapters, catalog, "Запрашивает тип прибора: протокол, команды, единицы")
Rel(adapters, devices, "Команды, показания", "Протоколы партнёров")

Rel(catalog, repo, "Читает и пишет типы приборов")
Rel(adapters, repo, "Читает настройки адаптеров")
Rel(repo, dbDIS, "Читает и пишет", "SQL")

SHOW_LEGEND()
@enduml
