@startuml security
!include <C4/C4_Component>

title Диаграмма компонентов: Модуль охраны

Container(Gateway, "API Gateway", ".NET (YARP)", "Единая точка входа: маршрутизация запросов к сервисам, проверка токена")
Container(Automation, "Модуль автоматизации", ".NET", "Микросервис: конструктор и выполнение сценариев")
Container(MediaServer, "Медиасервер", "HLS / WebRTC", "Забирает видеопоток с камер, отдаёт его пользователям (через Gateway) и в модуль охраны на анализ")
Container(VideoControl, "Управление видеонаблюдением", ".NET", "Микросервис: права на просмотр камер, управление трансляциями, команды камерам")
Container(GateControl, "Управление воротами", ".NET", "Микросервис")
Container(HouseConfigurator, "Модуль конфигурации дома", ".NET", "Микросервис: дом, зоны, периметр, расстановка приборов")
ContainerQueue(Broker, "Брокер сообщений", "RabbitMQ", "Доставка событий подписчикам: очередь на каждого подписчика, повторные попытки, очередь недоставленных")
ContainerDb(dbSecurity, "БД модуля охраны", "PostgreSQL", "Состояние и режим охраны, журнал тревог, разрешённые номера")

Container_Boundary(Security, "Модуль охраны") {
    Component(api, "API-контроллер", ".NET", "Принимает запросы: постановка и снятие с охраны, режимы, журнал тревог, перечень разрешённых номеров")
    Component(guard, "Сервис управления охраной", ".NET", "Постановка на охрану и снятие дома и периметра, режимы, состояние, журнал тревог; если постановка невозможна (например, открыта дверь) — событие «постановка не выполнена»; при постановке и снятии запускает и останавливает поток на анализ с камер периметра; поднимает тревогу при срабатывании датчика в зоне под охраной или объекте на периметре; решает, включать ли слежение; охрана удалённой зоны приостанавливается, при восстановлении возобновляется")
    Component(entry, "Сервис допуска автомобилей", ".NET", "Перечень разрешённых номеров; открывает ворота, только если распознанный номер есть в перечне и дом не на охране")
    Component(analytics, "Видеоаналитика", ".NET", "Анализирует видеопоток: распознаёт номера автомобилей, обнаруживает объекты на периметре, ведёт слежение за объектом")
    Component(publisher, "Публикатор событий", ".NET", "Публикует в брокер: тревога, постановка, постановка не выполнена, снятие (с correlationId вызова)")
    Component(subscriber, "Подписчик на события", ".NET", "Принимает события: показания и состояние приборов, зона удалена, зона восстановлена")
    Component(repo, "Репозиторий", ".NET", "Читает и пишет состояние и режим охраны, журнал тревог, разрешённые номера")
}

Rel(Gateway, api, "Управление охраной", "HTTPS")
Rel(Automation, api, "Постановка на охрану по сценарию", "HTTPS")
Rel(MediaServer, analytics, "Видеопоток на анализ", "Поток")
Rel(Broker, subscriber, "Доставляет: показания и состояние приборов, зона удалена, зона восстановлена", "AMQP")

Rel(api, guard, "Постановка, снятие, режимы, журнал тревог")
Rel(api, entry, "Перечень разрешённых номеров")
Rel(subscriber, guard, "Срабатывание датчика; приостановить или возобновить охрану зоны")

Rel(analytics, entry, "Распознан номер")
Rel(entry, guard, "Дом на охране?")
Rel(analytics, guard, "Объект на периметре")
Rel(guard, analytics, "Включить или выключить слежение")

Rel(guard, HouseConfigurator, "Дом, зоны, периметр", "HTTPS")
Rel(guard, VideoControl, "Запуск и остановка потока на анализ", "HTTPS")
Rel(analytics, VideoControl, "Команды камерам (слежение)", "HTTPS")
Rel(entry, GateControl, "Открытие ворот для разрешённого номера", "HTTPS")
Rel(guard, publisher, "Тревога, постановка, постановка не выполнена, снятие")

Rel(publisher, Broker, "Публикует: тревога, постановка, постановка не выполнена, снятие", "AMQP")

Rel(guard, repo, "Читает и пишет состояние, режимы, журнал тревог")
Rel(entry, repo, "Читает и пишет разрешённые номера")
Rel(repo, dbSecurity, "Читает и пишет", "SQL")

SHOW_LEGEND()
@enduml
