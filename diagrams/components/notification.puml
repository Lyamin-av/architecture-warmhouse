@startuml notification
!include <C4/C4_Component>

title Диаграмма компонентов: Модуль уведомлений

Container(Gateway, "API Gateway", ".NET (YARP)", "Единая точка входа: маршрутизация запросов к сервисам, проверка токена")
Container(Users, "Модуль регистрации пользователей", ".NET", "Микросервис: профили пользователей и ролевая модель")
ContainerQueue(Broker, "Брокер сообщений", "RabbitMQ", "Доставка событий подписчикам: очередь на каждого подписчика, повторные попытки, очередь недоставленных")
ContainerDb(dbNot, "БД модуля уведомлений", "PostgreSQL", "Шаблоны уведомлений, отправленные уведомления, настройки уведомлений пользователей")
System_Ext(notify, "Сервис уведомлений", "Доставка push, SMS и email")

Container_Boundary(Notification, "Модуль уведомлений") {
    Component(api, "API-контроллер", ".NET", "Принимает запросы: настройки уведомлений пользователя")
    Component(settings, "Сервис настроек уведомлений", ".NET", "Настройки пользователя по его идентификатору: каналы (push, SMS, email) и типы событий; настройки удалённого пользователя помечаются и не используются")
    Component(subscriber, "Подписчик на события", ".NET", "Принимает события: состояние приборов, результат команды (ошибки), события охраны и сценариев")
    Component(dispatcher, "Сервис рассылки", ".NET", "По событию определяет получателей по дому и ролям, отбирает их по настройкам (удалённые пользователи пропускаются), формирует текст по шаблону, отправляет и записывает в журнал отправленных")
    Component(repo, "Репозиторий", ".NET", "Читает и пишет настройки, шаблоны, отправленные уведомления")
}

Rel(Gateway, api, "Настройки уведомлений", "HTTPS")
Rel(Broker, subscriber, "Доставляет: состояние приборов, результат команды, события охраны и сценариев", "AMQP")

Rel(api, settings, "Чтение и изменение настроек")
Rel(subscriber, dispatcher, "Событие для рассылки")
Rel(dispatcher, Users, "Получатели по дому и ролям, контакты", "HTTPS")
Rel(dispatcher, notify, "Доставка push, SMS, email", "HTTPS")

Rel(settings, repo, "Читает и пишет настройки")
Rel(dispatcher, repo, "Читает настройки получателей и шаблоны, пишет отправленные уведомления")
Rel(repo, dbNot, "Читает и пишет", "SQL")

SHOW_LEGEND()
@enduml
