@startuml heating
!include <C4/C4_Component>

title Диаграмма компонентов: Управление отоплением

Container(Gateway, "API Gateway", ".NET (YARP)", "Единая точка входа: маршрутизация запросов к сервисам, проверка токена")
Container(Automation, "Модуль автоматизации", ".NET", "Микросервис: конструктор и выполнение сценариев")
Container(HouseConfigurator, "Модуль конфигурации дома", ".NET", "Микросервис: дом, зоны, периметр, расстановка приборов")
Container(Telematics, "Модуль телематики", ".NET", "Микросервис: управление приборами и телеметрия")
ContainerQueue(Broker, "Брокер сообщений", "RabbitMQ", "Доставка событий подписчикам: очередь на каждого подписчика, повторные попытки, очередь недоставленных")
ContainerDb(dbHeating, "БД управления отоплением", "PostgreSQL", "Температурные режимы")

Container_Boundary(Heating, "Управление отоплением") {
    Component(api, "API-контроллер", ".NET", "Принимает запросы: температурные режимы зон, команды по сценарию")
    Component(regimes, "Сервис температурных режимов", ".NET", "Хранит цель для зоны (целевая температура и режим: «в гостиной 22 °C», «эко-режим») и добивается её: сравнивает показание с целью и решает, какими командами каким приборам зоны её достичь — на каждое новое показание, а при смене цели сразу запрашивает текущую температуру внеочередным опросом; переключение по расписанию выполняет «Модуль автоматизации»; режимы удалённой зоны приостанавливаются, при восстановлении зоны возобновляются")
    Component(subscriber, "Подписчик на события", ".NET", "Принимает события: показания приборов, зона удалена, зона восстановлена")
    Component(repo, "Репозиторий", ".NET", "Читает и пишет температурные режимы")
}

Rel(Gateway, api, "Температурные режимы", "HTTPS")
Rel(Automation, api, "Команды по сценарию, в т. ч. смена режима по расписанию", "HTTPS")
Rel(Broker, subscriber, "Доставляет: показания приборов, зона удалена, зона восстановлена", "AMQP")

Rel(api, regimes, "Режимы зон, команда по сценарию")
Rel(subscriber, regimes, "Новое показание; приостановить или возобновить режимы зоны")
Rel(regimes, HouseConfigurator, "Зоны плана", "HTTPS")
Rel(regimes, Telematics, "Команды, внеочередной опрос", "HTTPS")

Rel(regimes, repo, "Читает и пишет режимы")
Rel(repo, dbHeating, "Читает и пишет", "SQL")

SHOW_LEGEND()
@enduml
