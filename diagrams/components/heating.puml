@startuml heating
!include <C4/C4_Component>

title Диаграмма компонентов: Управление отоплением

Container(Gateway, "API Gateway", ".NET (YARP)", "Единая точка входа: маршрутизация запросов к сервисам, проверка токена")
Container(Automation, "Модуль автоматизации", ".NET", "Микросервис: конструктор и выполнение сценариев")
Container(HouseConfigurator, "Модуль конфигурации дома", ".NET", "Микросервис: дом, зоны, периметр, расстановка приборов")
Container(Telematics, "Модуль телематики", ".NET", "Микросервис: управление приборами и телеметрия")
ContainerQueue(Broker, "Брокер сообщений", "RabbitMQ", "Доставка событий подписчикам: очередь на каждого подписчика, повторные попытки, очередь недоставленных")
ContainerDb(dbHeating, "БД управления отоплением", "PostgreSQL", "Температурные режимы")

Container_Boundary(Heating, "Управление отоплением") {
    Component(api, "API-контроллер", ".NET", "Принимает запросы: температурные режимы зон, команды по сценарию")
    Component(regimes, "Сервис температурных режимов", ".NET", "Хранит цель для зоны (целевая температура и режим: «в гостиной 22 °C», «эко-режим») и передаёт её приборам отопления зоны — умным термостатам, которые держат температуру сами; по показаниям следит, прогревается ли зона, в будущем — регулирование «простых» приборов (вкл / выкл); переключение по расписанию выполняет «Модуль автоматизации»; режимы удалённой зоны приостанавливаются, при восстановлении зоны возобновляются; по результатам своих команд подводит итог: режим применён или не применён")
    Component(subscriber, "Подписчик на события", ".NET", "Принимает события: показания приборов, результат команды, зона удалена, зона восстановлена")
    Component(publisher, "Публикатор итогов", ".NET", "Публикует в брокер итог применения режима с correlationId вызова")
    Component(repo, "Репозиторий", ".NET", "Читает и пишет температурные режимы")
}

Rel(Gateway, api, "Температурные режимы", "HTTPS")
Rel(Automation, api, "Команды по сценарию, в т. ч. смена режима по расписанию", "HTTPS")
Rel(Broker, subscriber, "Доставляет: показания приборов, результат команды, зона удалена, зона восстановлена", "AMQP")

Rel(api, regimes, "Режимы зон, команда по сценарию")
Rel(subscriber, regimes, "Показание (прогревается ли зона), результат команды; приостановить или возобновить режимы зоны")
Rel(regimes, publisher, "Режим применён или не применён")
Rel(publisher, Broker, "Публикует: режим применён / не применён", "AMQP")
Rel(regimes, HouseConfigurator, "Зоны плана, приборы зоны по категории и виду", "HTTPS")
Rel(regimes, Telematics, "Команды", "HTTPS")

Rel(regimes, repo, "Читает и пишет режимы")
Rel(repo, dbHeating, "Читает и пишет", "SQL")

SHOW_LEGEND()
@enduml
