@startuml automation
!include <C4/C4_Component>

title Диаграмма компонентов: Модуль автоматизации

Container(Gateway, "API Gateway", ".NET (YARP)", "Единая точка входа: маршрутизация запросов к сервисам, проверка токена")
Container(HouseConfigurator, "Модуль конфигурации дома", ".NET", "Микросервис: дом, зоны, периметр, расстановка приборов")
Container(DeviceIntegration, "Модуль интеграции приборов", ".NET", "Микросервис: адаптеры протоколов и каталог типов приборов")
Container(Heating, "Управление отоплением", ".NET", "Микросервис: температурные режимы зон")
Container(Lighting, "Управление освещением", ".NET", "Микросервис")
Container(GateControl, "Управление воротами", ".NET", "Микросервис")
Container(VideoControl, "Управление видеонаблюдением", ".NET", "Микросервис: права на просмотр камер, управление трансляциями, команды камерам")
Container(Security, "Модуль охраны", ".NET", "Микросервис: управление охраной и видеоаналитика")
ContainerQueue(Broker, "Брокер сообщений", "RabbitMQ", "Доставка событий подписчикам: очередь на каждого подписчика, повторные попытки, очередь недоставленных")
ContainerDb(dbAuto, "БД модуля автоматизации", "PostgreSQL", "Сценарии, конфигурации сценариев, текущее состояние приборов и охраны")

Container_Boundary(Automation, "Модуль автоматизации") {
    Component(api, "API-контроллер", ".NET", "Принимает запросы: создание и изменение сценариев, включение и выключение, ручной запуск")
    Component(designer, "Конструктор сценариев", ".NET", "Программирование системы пользователем: условия и действия сценария из приборов и зон дома и возможностей приборов из каталога; сценарии с удалённой зоной помечаются неработающими, при восстановлении зоны возвращаются в работу")
    Component(executor, "Выполнение сценариев", ".NET", "Сценарий: при [триггер] если [условие] то [действия]. Триггеры — событие, расписание (внутреннее), ручной запуск; условия проверяют текущее состояние дома, которое обновляется по каждому событию; при выполнении отдаёт команды через контексты типов приборов")
    Component(subscriber, "Подписчик на события", ".NET", "Принимает события: показания и состояние приборов, события охраны, удаление и восстановление зон")
    Component(publisher, "Публикатор событий", ".NET", "Публикует в брокер: сценарий сработал")
    Component(repo, "Репозиторий", ".NET", "Читает и пишет сценарии, их конфигурации и текущее состояние приборов и охраны")
}

Rel(Gateway, api, "Конструктор сценариев", "HTTPS")
Rel(Broker, subscriber, "Доставляет: показания, состояние приборов, события охраны, удаление и восстановление зон", "AMQP")

Rel(api, designer, "Создание и изменение сценариев")
Rel(api, executor, "Ручной запуск сценария")
Rel(designer, HouseConfigurator, "Приборы и зоны для сценариев", "HTTPS")
Rel(designer, DeviceIntegration, "Возможности приборов из каталога", "HTTPS")
Rel(subscriber, designer, "Зона удалена или восстановлена")
Rel(subscriber, executor, "Показание, состояние прибора, событие охраны")

Rel(executor, Heating, "Команды по сценарию", "HTTPS")
Rel(executor, Lighting, "Команды по сценарию", "HTTPS")
Rel(executor, GateControl, "Команды по сценарию", "HTTPS")
Rel(executor, VideoControl, "Команды по сценарию", "HTTPS")
Rel(executor, Security, "Постановка на охрану по сценарию", "HTTPS")
Rel(executor, publisher, "Сценарий сработал")
Rel(publisher, Broker, "Публикует: сценарий сработал", "AMQP")

Rel(designer, repo, "Читает и пишет сценарии")
Rel(executor, repo, "Читает активные сценарии, читает и пишет текущее состояние приборов и охраны")
Rel(repo, dbAuto, "Читает и пишет", "SQL")

SHOW_LEGEND()
@enduml
