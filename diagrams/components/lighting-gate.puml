@startuml lighting-gate
!include <C4/C4_Component>

title Диаграмма компонентов: Управление освещением и Управление воротами

Container(Gateway, "API Gateway", ".NET (YARP)", "Единая точка входа: маршрутизация запросов к сервисам, проверка токена")
Container(Automation, "Модуль автоматизации", ".NET", "Микросервис: конструктор и выполнение сценариев")
Container(Security, "Модуль охраны", ".NET", "Микросервис: управление охраной и видеоаналитика")
Container(Telematics, "Модуль телематики", ".NET", "Микросервис: управление приборами и телеметрия")

Container_Boundary(Lighting, "Управление освещением") {
    Component(lApi, "API-контроллер", ".NET", "Принимает запросы на управление светом")
    Component(lService, "Сервис управления освещением", ".NET", "Формирует команды для осветительных приборов и передаёт их в «Модуль телематики»")
}

Container_Boundary(GateControl, "Управление воротами") {
    Component(gApi, "API-контроллер", ".NET", "Принимает запросы на управление воротами")
    Component(gService, "Сервис управления воротами", ".NET", "Формирует команды для приводов ворот (открыть, закрыть) и передаёт их в «Модуль телематики»")
}

Rel(Gateway, lApi, "Управление светом", "HTTPS")
Rel(Automation, lApi, "Команды по сценарию", "HTTPS")
Rel(lApi, lService, "Команда управления светом")
Rel(lService, Telematics, "Команды", "HTTPS")

Rel(Gateway, gApi, "Управление воротами", "HTTPS")
Rel(Automation, gApi, "Команды по сценарию", "HTTPS")
Rel(Security, gApi, "Открытие ворот для разрешённого номера", "HTTPS")
Rel(gApi, gService, "Команда управления воротами")
Rel(gService, Telematics, "Команды", "HTTPS")

SHOW_LEGEND()
@enduml
