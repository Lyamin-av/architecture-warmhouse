@startuml house-configurator
!include <C4/C4_Component>

title Диаграмма компонентов: Модуль конфигурации дома

Container(Gateway, "API Gateway", ".NET (YARP)", "Единая точка входа: маршрутизация запросов к сервисам, проверка токена")
Container(Heating, "Управление отоплением", ".NET", "Микросервис: температурные режимы зон")
Container(Security, "Модуль охраны", ".NET", "Микросервис: управление охраной и видеоаналитика")
Container(VideoControl, "Управление видеонаблюдением", ".NET", "Микросервис: права на просмотр камер, управление трансляциями, команды камерам")
Container(Users, "Модуль регистрации пользователей", ".NET", "Микросервис: профили пользователей и ролевая модель")
Container(Automation, "Модуль автоматизации", ".NET", "Микросервис: конструктор и выполнение сценариев")
ContainerQueue(Broker, "Брокер сообщений", "RabbitMQ", "Доставка событий подписчикам: очередь на каждого подписчика, повторные попытки, очередь недоставленных")
ContainerDb(dbHC, "БД модуля конфигурации дома", "PostgreSQL", "План дома, зоны, приборы")

Container_Boundary(HouseConfigurator, "Модуль конфигурации дома") {
    Component(api, "API-контроллер", ".NET", "Принимает запросы: план дома, зоны, расстановка приборов, удаление и восстановление зон и приборов")
    Component(plan, "Сервис плана дома", ".NET", "Дом, зоны и периметр (периметр — зона на плане): создание, изменение, выдача; удаление помечает зону удалённой, удалённая зона не выдаётся, восстановление возвращает её")
    Component(placement, "Сервис расстановки приборов", ".NET", "Ссылка на прибор по идентификатору, его место и зона, признак «распределён / не распределён», список нераспределённых («Новые приборы»); удалённый прибор помечается удалённым, пропадает с плана, история сохраняется, возможно восстановление")
    Component(subscriber, "Подписчик на события приборов", ".NET", "Принимает события о новых и удалённых приборах (удалённый — в архив с пометкой)")
    Component(publisher, "Публикатор событий о зонах", ".NET", "Публикует в брокер события об удалении и восстановлении зон")
    Component(repo, "Репозиторий", ".NET", "Читает и пишет дом, зоны, периметр, приборы на плане, включая признак «удалён»")
}

Rel(Gateway, api, "План дома, расстановка приборов", "HTTPS")
Rel(Heating, api, "Зоны плана", "HTTPS")
Rel(Security, api, "Дом, зоны, периметр", "HTTPS")
Rel(VideoControl, api, "Зона камеры", "HTTPS")
Rel(Users, api, "Дом и зоны плана для ролей", "HTTPS")
Rel(Automation, api, "Приборы и зоны для сценариев", "HTTPS")
Rel(Broker, subscriber, "Доставляет: новые и удалённые приборы", "AMQP")

Rel(api, plan, "Дом, зоны, периметр")
Rel(api, placement, "Расстановка приборов, нераспределённые приборы")
Rel(subscriber, placement, "Новый или удалённый прибор")
Rel(placement, plan, "Зона для прибора")
Rel(plan, publisher, "Зона удалена или восстановлена")
Rel(publisher, Broker, "Публикует: зона удалена, зона восстановлена", "AMQP")
Rel(plan, repo, "Читает и пишет дом и зоны")
Rel(placement, repo, "Читает и пишет приборы на плане")

Rel(repo, dbHC, "Читает и пишет", "SQL")

SHOW_LEGEND()
@enduml
