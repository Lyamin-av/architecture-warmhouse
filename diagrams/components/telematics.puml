@startuml telematics
!include <C4/C4_Component>

title Диаграмма компонентов: Модуль телематики

Container(Gateway, "API Gateway", ".NET (YARP)", "Единая точка входа: маршрутизация запросов к сервисам, проверка токена")
Container(Heating, "Управление отоплением", ".NET", "Микросервис: температурные режимы зон")
Container(Lighting, "Управление освещением", ".NET", "Микросервис")
Container(GateControl, "Управление воротами", ".NET", "Микросервис")
Container(VideoControl, "Управление видеонаблюдением", ".NET", "Микросервис: права на просмотр камер, управление трансляциями, команды камерам")
Container(DeviceIntegration, "Модуль интеграции приборов", ".NET", "Микросервис: адаптеры протоколов и каталог моделей приборов")
ContainerQueue(Broker, "Брокер сообщений", "RabbitMQ", "Доставка событий подписчикам: очередь на каждого подписчика, повторные попытки, очередь недоставленных")
ContainerDb(dbTelematics, "БД модуля телематики", "PostgreSQL", "Приборы и их настройки, архив показаний, журнал команд")

Container_Boundary(Telematics, "Модуль телематики") {
    Component(api, "API-контроллер", ".NET", "Принимает запросы: сопряжение, настройка, команды, показания")
    Component(devices, "Сервис управления приборами", ".NET", "Хозяин прибора: сопряжение и присвоение идентификатора, удаление в архив и восстановление, настройка (частота опроса, адрес, калибровка), команды — единственный путь команд к приборам; ведёт журнал команд (инициатор, correlationId, статус), сопоставляет результат с командой по идентификатору, при отсутствии ответа фиксирует таймаут")
    Component(telemetry, "Сервис телеметрии", ".NET", "Единственный контекст, запрашивающий показания: плановый опрос по расписанию (частота из настроек прибора) и внеочередной, архив показаний, выдача текущих и исторических значений; по результатам опроса определяет состояние прибора (работает, нет связи)")
    Component(subscriber, "Подписчик на результаты команд", ".NET", "Принимает от модуля интеграции приборов результат команды от адаптера")
    Component(publisher, "Публикатор событий", ".NET", "Публикует в брокер: показания, состояние приборов, новые (с моделью, категорией и видом), удалённые и восстановленные приборы, результат команды")
    Component(repo, "Репозиторий", ".NET", "Читает и пишет приборы, настройки, архив показаний, журнал команд")
}

Rel(Gateway, api, "Сопряжение, настройка, показания", "HTTPS")
Rel(Heating, api, "Команды, внеочередной опрос", "HTTPS")
Rel(Lighting, api, "Команды", "HTTPS")
Rel(GateControl, api, "Команды", "HTTPS")
Rel(VideoControl, api, "Команды камерам", "HTTPS")

Rel(api, devices, "Сопряжение, удаление, настройка, команды")
Rel(api, telemetry, "Показания: текущие, исторические, внеочередной опрос")

Rel(telemetry, devices, "Приборы и частота опроса")
Rel(telemetry, DeviceIntegration, "Опрос через адаптеры", "HTTPS")
Rel(devices, DeviceIntegration, "Сопряжение (модель, категория и вид из каталога), команды через адаптер", "HTTPS")
Rel(Broker, subscriber, "Доставляет: результат команды от адаптера", "AMQP")
Rel(subscriber, devices, "Результат команды")

Rel(telemetry, publisher, "Новые показания, изменение состояния прибора")
Rel(devices, publisher, "Прибор добавлен или удалён, результат команды")
Rel(publisher, Broker, "Публикует: показания, состояние приборов, новые (с моделью, категорией и видом), удалённые и восстановленные приборы, результат команды", "AMQP")

Rel(devices, repo, "Читает и пишет приборы, настройки и журнал команд")
Rel(telemetry, repo, "Читает и пишет архив показаний и состояние приборов")
Rel(repo, dbTelematics, "Читает и пишет", "SQL")

SHOW_LEGEND()
@enduml
