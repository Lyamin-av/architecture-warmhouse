@startuml video-control
!include <C4/C4_Component>

title Диаграмма компонентов: Управление видеонаблюдением

Container(Gateway, "API Gateway", ".NET (YARP)", "Единая точка входа: маршрутизация запросов к сервисам, проверка токена")
Container(MediaServer, "Медиасервер", "HLS / WebRTC", "Забирает видеопоток с камер, отдаёт его пользователям (через Gateway) и в модуль охраны на анализ")
Container(Security, "Модуль охраны", ".NET", "Микросервис: управление охраной и видеоаналитика")
Container(Automation, "Модуль автоматизации", ".NET", "Микросервис: конструктор и выполнение сценариев")
Container(HouseConfigurator, "Модуль конфигурации дома", ".NET", "Микросервис: дом, зоны, периметр, расстановка приборов")
Container(Users, "Модуль регистрации пользователей", ".NET", "Микросервис: профили пользователей и ролевая модель")
Container(Telematics, "Модуль телематики", ".NET", "Микросервис: управление приборами и телеметрия")
ContainerQueue(Broker, "Брокер сообщений", "RabbitMQ", "Доставка событий подписчикам: очередь на каждого подписчика, повторные попытки, очередь недоставленных")

Container_Boundary(VideoControl, "Управление видеонаблюдением") {
    Component(api, "API-контроллер", ".NET", "Принимает запросы: список камер, права на просмотр, проверка прав от медиасервера, команды камерам")
    Component(access, "Сервис доступа к камерам", ".NET", "Показывает пользователю только камеры в видимых ему зонах: зона камеры — из «Конфигурации дома», видимые зоны — из «Пользователей»; проверяет право на просмотр по запросу медиасервера")
    Component(streams, "Сервис трансляций", ".NET", "Запускает и останавливает трансляции камер на медиасервере: для просмотра пользователем и поток на анализ в модуль охраны по его запросу (камера у ворот — постоянно, камеры периметра — пока дом на охране)")
    Component(commands, "Сервис команд камерам", ".NET", "Команды камерам: поворот, приближение, слежение")
    Component(subscriber, "Подписчик на события зон", ".NET", "Принимает события: зона удалена, зона восстановлена")
    Component(hcClient, "Клиент конфигурации дома", ".NET", "Запрашивает зону камеры")
    Component(usersClient, "Клиент пользователей", ".NET", "Запрашивает зоны, видимые пользователю")
    Component(mediaClient, "Клиент медиасервера", ".NET", "Управляет трансляциями на медиасервере")
    Component(tmClient, "Клиент телематики", ".NET", "Отправляет команды камерам")
}

Rel(Gateway, api, "Список камер, права на просмотр", "HTTPS")
Rel(MediaServer, api, "Проверка прав на просмотр камеры", "HTTPS")
Rel(Security, api, "Команды камерам (слежение), запуск и остановка потока на анализ", "HTTPS")
Rel(Automation, api, "Команды по сценарию", "HTTPS")
Rel(Broker, subscriber, "Доставляет: зона удалена, зона восстановлена", "AMQP")

Rel(api, access, "Список камер, проверка прав")
Rel(api, streams, "Запуск просмотра, запуск и остановка потока на анализ")
Rel(api, commands, "Команда камере")
Rel(streams, access, "Есть ли право на просмотр")
Rel(subscriber, streams, "Остановить трансляции камер удалённой зоны")

Rel(access, hcClient, "Зона камеры")
Rel(access, usersClient, "Видимые зоны пользователя")
Rel(streams, mediaClient, "Запуск и остановка трансляции")
Rel(commands, tmClient, "Команда камере")

Rel(hcClient, HouseConfigurator, "Зона камеры", "HTTPS")
Rel(usersClient, Users, "Зоны, видимые пользователю", "HTTPS")
Rel(mediaClient, MediaServer, "Управление трансляциями камер", "HTTPS")
Rel(tmClient, Telematics, "Команды камерам", "HTTPS")

SHOW_LEGEND()
@enduml
