@startuml users
!include <C4/C4_Component>

title Диаграмма компонентов: Модуль регистрации пользователей

Container(Gateway, "API Gateway", ".NET (YARP)", "Единая точка входа: маршрутизация запросов к сервисам, проверка токена")
Container(VideoControl, "Управление видеонаблюдением", ".NET", "Микросервис: права на просмотр камер, управление трансляциями, команды камерам")
Container(Notification, "Модуль уведомлений", ".NET", "Микросервис: рассылка уведомлений")
Container(Authentication, "Модуль аутентификации", ".NET", "Микросервис: вход и проверка личности")
Container(HouseConfigurator, "Модуль конфигурации дома", ".NET", "Микросервис: дом, зоны, периметр, расстановка приборов")
ContainerDb(dbUsers, "БД пользователей", "PostgreSQL", "Пользователи, информация о пользователях, ролевая модель")

Container_Boundary(Users, "Модуль регистрации пользователей") {
    Component(api, "API-контроллер", ".NET", "Принимает запросы: регистрация, роли, зоны пользователя, получатели и контакты")
    Component(registration, "Сервис регистрации", ".NET", "Регистрирует пользователей, ведёт профиль (имя, контакты), меняет логин и почту")
    Component(roles, "Сервис ролевой модели", ".NET", "Связь «пользователь — дом — роль», права и видимость зон, получатели по дому и ролям")
    Component(authClient, "Клиент аутентификации", ".NET", "Передаёт «Аутентификации» логин и почту при регистрации и при их смене")
    Component(houseClient, "Клиент конфигурации дома", ".NET", "Запрашивает дом и зоны плана для назначения ролей и видимости зон")
    Component(repo, "Репозиторий", ".NET", "Читает и пишет профили, роли, ссылки на дом и зоны")
}

Rel(Gateway, api, "Регистрация, роли", "HTTPS")
Rel(VideoControl, api, "Зоны, видимые пользователю", "HTTPS")
Rel(Notification, api, "Получатели по дому и ролям, контакты", "HTTPS")

Rel(api, registration, "Регистрация, профиль, контакты")
Rel(api, roles, "Роли, зоны пользователя, получатели")
Rel(roles, registration, "Получает пользователей")
Rel(registration, authClient, "Создание учётных данных, смена логина и почты")
Rel(registration, repo, "Читает и пишет профили")
Rel(roles, repo, "Читает и пишет роли, ссылки на дом и зоны")

Rel(roles, houseClient, "Запрос дома и зон плана")
Rel(houseClient, HouseConfigurator, "Дом и зоны плана для ролей", "HTTPS")
Rel(authClient, Authentication, "Создаёт учётные данные при регистрации", "HTTPS")
Rel(authClient, Authentication, "Обновляет логин и почту при смене", "HTTPS")
Rel(repo, dbUsers, "Читает и пишет", "SQL")

SHOW_LEGEND()
@enduml
