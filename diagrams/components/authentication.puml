@startuml authentication
!include <C4/C4_Component>

title Диаграмма компонентов: Модуль аутентификации

Container(Gateway, "API Gateway", ".NET (YARP)", "Единая точка входа: маршрутизация запросов к сервисам, проверка токена")
Container(Users, "Модуль регистрации пользователей", ".NET", "Микросервис: профили пользователей и ролевая модель")
ContainerDb(dbAuth, "БД модуля аутентификации", "PostgreSQL", "Учётные данные, логины и почты (копия из профиля), токены обновления и сброса пароля, логирование")
System_Ext(notify, "Сервис уведомлений", "Доставка push, SMS и email")

Container_Boundary(Authentication, "Модуль аутентификации") {
    Component(api, "API-контроллер", ".NET", "Принимает запросы: вход, обновление токена, сброс пароля, создание и обновление учётных данных, публичный ключ")
    Component(credentials, "Сервис учётных данных", ".NET", "Создаёт учётные данные (логин, почта, пароль), проверяет пароль, обновляет логин и почту, устанавливает новый пароль")
    Component(tokens, "Сервис токенов", ".NET", "Выдаёт и обновляет токены (JWT доступа, токен обновления), отдаёт публичный ключ для проверки подписи")
    Component(reset, "Сервис сброса пароля", ".NET", "Принимает запрос сброса по логину или почте, создаёт одноразовый токен со сроком жизни, подтверждает сброс")
    Component(email, "E-mail компонент", ".NET", "Формирует и отправляет письмо со ссылкой для сброса пароля")
    Component(audit, "Журнал входов", ".NET", "Фиксирует попытки входа")
    Component(repo, "Репозиторий", ".NET", "Читает и пишет учётные данные, токены обновления и токены сброса пароля")
}

Rel(Gateway, api, "Вход, обновление токена", "HTTPS")
Rel(Gateway, api, "Запрос и подтверждение сброса пароля", "HTTPS")
Rel(Gateway, api, "Публичный ключ для проверки токена", "HTTPS")
Rel(Users, api, "Создаёт учётные данные при регистрации", "HTTPS")
Rel(Users, api, "Обновляет логин и почту при смене", "HTTPS")

Rel(api, credentials, "Создание и обновление учётных данных, проверка пароля")
Rel(api, tokens, "Выдача и обновление токенов, публичный ключ")
Rel(api, reset, "Запрос и подтверждение сброса")
Rel(credentials, tokens, "Запрос токенов после успешной проверки пароля")
Rel(credentials, repo, "Читает и пишет учётные данные")
Rel(credentials, audit, "Фиксирует попытку входа")
Rel(tokens, repo, "Хранит и отзывает токены обновления")
Rel(reset, repo, "Ищет учётные данные по логину или почте, хранит токены сброса")
Rel(reset, credentials, "Устанавливает новый пароль")
Rel(reset, tokens, "Отзывает токены обновления после смены пароля")
Rel(reset, email, "Отправить письмо со ссылкой")

Rel(email, notify, "Письмо для сброса пароля", "HTTPS")
Rel(repo, dbAuth, "Читает и пишет", "SQL")
Rel(audit, dbAuth, "Пишет журнал", "SQL")

SHOW_LEGEND()
@enduml
