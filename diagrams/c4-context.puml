@startuml c4-context
!include <C4/C4_Context>

title Диаграмма контекста: Умный дом (To-Be)

Person(homeowner, "Владелец дома", "Подключает приборы, настраивает план дома, сценарии, охрану и доступ для других пользователей")
Person(member, "Пользователь с ограниченными правами", "Член семьи или гость: видит и управляет только разрешёнными зонами")
Person(partner, "Партнёр-производитель", "Добавляет описания моделей своих приборов в каталог")

System(warmhouse, "Умный дом", "SaaS-экосистема: мониторинг, управление приборами, сценарии, охрана, подключение приборов партнёров")

System_Ext(devices, "Приборы партнёров", "Датчики и исполнительные устройства: отопление, свет, ворота и др.")
System_Ext(cameras, "Камеры", "Камеры видеонаблюдения партнёров")
System_Ext(notify, "Сервис уведомлений", "Доставка push, SMS и email")

Rel(homeowner, warmhouse, "Управляет домом, приборами, сценариями и доступом", "HTTPS")
Rel(member, warmhouse, "Смотрит и управляет разрешёнными зонами", "HTTPS")
Rel(partner, warmhouse, "Публикует описания моделей приборов", "HTTPS")

Rel(warmhouse, devices, "Опрашивает показания и отправляет команды", "Zigbee, Z-Wave, MQTT, Modbus")
Rel(warmhouse, cameras, "Получает видеопоток и управляет камерами", "RTSP / ONVIF")
Rel(warmhouse, notify, "Отправляет уведомления о тревогах и событиях", "HTTPS")
Rel(notify, homeowner, "Доставляет уведомления")

SHOW_LEGEND()
@enduml
