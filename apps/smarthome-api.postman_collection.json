        {
            "name": "temperature-api",
            "description": "Проверка temperature-api (Задание 5): напрямую на порту 8081 и через монолит. В каждом запросе есть тесты (вкладка Test Results); тест «value отличается» срабатывает со второго вызова.",
            "item": [
                {
                    "name": "Health Check",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                                    "pm.test('status = ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{temperatureApiUrl}}/health",
                            "host": [
                                "{{temperatureApiUrl}}"
                            ],
                            "path": [
                                "health"
                            ]
                        },
                        "description": "Проверка работоспособности temperature-api"
                    },
                    "response": []
                },
                {
                    "name": "Temperature by Location (Kitchen)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Статус 200', () => pm.response.to.have.status(200));",
                                    "const r = pm.response.json();",
                                    "pm.test('Есть все поля ответа', () => {",
                                    "    ['value','unit','timestamp','location','status','sensor_id','sensor_type','description']",
                                    "        .forEach(f => pm.expect(r).to.have.property(f));",
                                    "});",
                                    "pm.test('value — число', () => pm.expect(r.value).to.be.a('number'));",
                                    "pm.test('location = Kitchen', () => pm.expect(r.location).to.eql('Kitchen'));",
                                    "pm.test('sensor_id = 3', () => pm.expect(r.sensor_id).to.eql('3'));",
                                    "const prev = pm.collectionVariables.get('lastKitchen');",
                                    "if (prev !== undefined && prev !== '') {",
                                    "    pm.test('value отличается от предыдущего вызова', () => pm.expect(r.value).to.not.eql(Number(prev)));",
                                    "}",
                                    "pm.collectionVariables.set('lastKitchen', r.value);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{temperatureApiUrl}}/temperature?location=Kitchen",
                            "host": [
                                "{{temperatureApiUrl}}"
                            ],
                            "path": [
                                "temperature"
                            ],
                            "query": [
                                {
                                    "key": "location",
                                    "value": "Kitchen"
                                }
                            ]
                        },
                        "description": "Основной эндпоинт задания: случайная температура по локации. Отправьте несколько раз — value меняется."
                    },
                    "response": []
                },
